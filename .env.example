# 复制本文件为 .env 后填写（.env 已被 .gitignore 忽略，不会提交到仓库）
# 不配置 AI_API_KEY 时系统自动使用「本地规则引擎」，AI 功能依然可用

# ---- AI 能力（可选，但推荐）----
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=15000

# ---- 服务与业务参数（可选）----
# PORT=3000
# HOST=0.0.0.0
# DB_PATH=data/app.db
# TOKEN_SECRET=please-change-me
# LOCK_MINUTES=10
# CANCEL_HOURS=2
# BOOKING_DAYS_AHEAD=30
# HTTP_LOG=1
