{
  "name": "sports-booking-system",
  "version": "2.0.0",
  "private": true,
  "description": "运动场馆易约 · 前后端分离版：frontend(原生 SPA) + backend(Node 零依赖) + shared(前后端公用模块)，SQLite 数据库，管理后台可增删改",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node backend/src/server.js",
